{
  "name": "@nebutra/tokens",
  "version": "4.0.1",
  "description": "Unified theme tokens and theme-provider entry for Nebutra apps",
  "private": false,
  "nebutra": {
    "status": "foundation",
    "graph": "core",
    "productionReady": false
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./styles.css",
    "./recipe.css",
    "./fonts.css",
    "./skins/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./recipe.css": "./recipe.css",
    "./fonts.css": "./fonts.css",
    "./fonts": {
      "types": "./src/fonts/next.tsx",
      "import": "./src/fonts/next.tsx",
      "default": "./src/fonts/next.tsx"
    },
    "./fonts/registry": {
      "types": "./src/fonts/registry.ts",
      "import": "./src/fonts/registry.ts",
      "default": "./src/fonts/registry.ts"
    },
    "./fonts/faces": {
      "types": "./src/fonts/faces.tsx",
      "import": "./src/fonts/faces.tsx",
      "default": "./src/fonts/faces.tsx"
    },
    "./skins/*": "./skins/*",
    "./brands/*": "./brands/*",
    "./brand-package": {
      "types": "./dist/brand-package/index.d.ts",
      "import": "./dist/brand-package/index.js",
      "default": "./dist/brand-package/index.js"
    },
    "./use-brand": {
      "types": "./dist/brand-package/use-brand.d.ts",
      "import": "./dist/brand-package/use-brand.js",
      "default": "./dist/brand-package/use-brand.js"
    },
    "./values": {
      "types": "./dist/values.d.ts",
      "import": "./dist/values.js",
      "default": "./dist/values.js"
    },
    "./preset": {
      "types": "./dist/preset/index.d.ts",
      "import": "./dist/preset/index.js",
      "default": "./dist/preset/index.js"
    },
    "./project.css": "./project.css"
  },
  "scripts": {
    "build": "node scripts/sync-styles.mjs && node scripts/copy-fonts.mjs && node scripts/emit-values.mjs && node scripts/emit-skins.mjs && node scripts/emit-project.mjs && tsup",
    "sync": "node scripts/sync-styles.mjs",
    "emit-skins": "node scripts/emit-skins.mjs",
    "compile-brand": "node scripts/compile-brand.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/brand-package/__tests__/*.test.ts src/preset/__tests__/*.test.ts src/__tests__/*.test.ts",
    "emit-values": "node scripts/emit-values.mjs",
    "copy-fonts": "node scripts/copy-fonts.mjs"
  },
  "dependencies": {
    "@nebutra/brand": "file:./vendor/nebutra__brand",
    "@nebutra/design-tokens": "file:./vendor/nebutra__design-tokens",
    "@nebutra/fonts": "file:./vendor/nebutra__fonts",
    "geist": "^1.3.1"
  },
  "peerDependencies": {
    "react": "^19",
    "next": ">=15"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "tsup": "^8.5.1",
    "react": "^19"
  },
  "homepage": "https://github.com/Nebutra/tokens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nebutra/tokens.git"
  },
  "bugs": {
    "url": "https://github.com/Nebutra/tokens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "styles.css",
    "recipe.css",
    "src/fonts",
    "fonts",
    "fonts.css",
    "skins",
    "brands",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "project.css",
    "project"
  ],
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "nebutraMirror": {
    "sourceRepository": "Nebutra/Nebutra-Sailor",
    "sourceDirectory": "packages/design/tokens",
    "sourcePackage": "@nebutra/tokens",
    "sourceSha": "41256d53bd71bed51c8e04b6af4ea7073791ff23",
    "canonicalSource": "monorepo"
  },
  "packageManager": "pnpm@11.28.5"
}
