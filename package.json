{
  "name": "@nebutra/tokens",
  "version": "4.0.1",
  "description": "Unified theme tokens and theme-provider entry for Nebutra apps",
  "private": false,
  "nebutra": {
    "status": "foundation",
    "graph": "core",
    "productionReady": false
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./styles.css",
    "./recipe.css",
    "./skins/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./recipe.css": "./recipe.css",
    "./skins/*": "./skins/*",
    "./brands/*": "./brands/*",
    "./brand-package": {
      "types": "./dist/brand-package/index.d.ts",
      "import": "./dist/brand-package/index.js",
      "default": "./dist/brand-package/index.js"
    },
    "./use-brand": {
      "types": "./dist/brand-package/use-brand.d.ts",
      "import": "./dist/brand-package/use-brand.js",
      "default": "./dist/brand-package/use-brand.js"
    },
    "./values": {
      "types": "./dist/values.d.ts",
      "import": "./dist/values.js",
      "default": "./dist/values.js"
    },
    "./preset": {
      "types": "./dist/preset/index.d.ts",
      "import": "./dist/preset/index.js",
      "default": "./dist/preset/index.js"
    },
    "./project.css": "./project.css"
  },
  "scripts": {
    "build": "node scripts/sync-styles.mjs && node scripts/emit-values.mjs && node scripts/emit-skins.mjs && node scripts/emit-project.mjs && tsup",
    "sync": "node scripts/sync-styles.mjs",
    "emit-skins": "node scripts/emit-skins.mjs",
    "compile-brand": "node scripts/compile-brand.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/brand-package/__tests__/*.test.ts src/preset/__tests__/*.test.ts src/__tests__/*.test.ts",
    "emit-values": "node scripts/emit-values.mjs"
  },
  "dependencies": {
    "@nebutra/brand": "file:./vendor/nebutra__brand",
    "@nebutra/design-tokens": "file:./vendor/nebutra__design-tokens",
    "@nebutra/fonts": "file:./vendor/nebutra__fonts"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "tsup": "^8.5.1",
    "react": "^19"
  },
  "homepage": "https://github.com/Nebutra/tokens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nebutra/tokens.git"
  },
  "bugs": {
    "url": "https://github.com/Nebutra/tokens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "styles.css",
    "recipe.css",
    "skins",
    "brands",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "project.css",
    "project"
  ],
  "nebutraMirror": {
    "sourceRepository": "Nebutra/Nebutra-Sailor",
    "sourceDirectory": "packages/design/tokens",
    "sourcePackage": "@nebutra/tokens",
    "sourceSha": "1b927886963a3e5c749b20867061bd7009b62d8b",
    "canonicalSource": "monorepo"
  },
  "packageManager": "pnpm@11.28.5"
}
