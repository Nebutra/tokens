{
  "name": "@nebutra/tokens",
  "version": "0.1.3",
  "description": "Unified theme tokens and theme-provider entry for Nebutra apps",
  "private": false,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./styles.css",
    "./recipe.css",
    "./skins/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./recipe.css": "./recipe.css",
    "./skins/*": "./skins/*",
    "./brands/*": "./brands/*",
    "./brand-package": {
      "types": "./dist/brand-package/index.d.ts",
      "import": "./dist/brand-package/index.js",
      "default": "./dist/brand-package/index.js"
    },
    "./use-brand": {
      "types": "./dist/brand-package/use-brand.d.ts",
      "import": "./dist/brand-package/use-brand.js",
      "default": "./dist/brand-package/use-brand.js"
    }
  },
  "scripts": {
    "build": "node scripts/sync-styles.mjs && node scripts/emit-skins.mjs && tsup",
    "sync": "node scripts/sync-styles.mjs",
    "emit-skins": "node scripts/emit-skins.mjs",
    "compile-brand": "node scripts/compile-brand.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/brand-package/__tests__/*.test.ts"
  },
  "dependencies": {
    "@nebutra/design-tokens": "file:./vendor/nebutra__design-tokens"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "tsup": "^8.5.1",
    "react": "^19"
  },
  "homepage": "https://github.com/Nebutra/tokens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nebutra/tokens.git"
  },
  "bugs": {
    "url": "https://github.com/Nebutra/tokens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "styles.css",
    "recipe.css",
    "skins",
    "brands",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "nebutraMirror": {
    "sourceRepository": "Nebutra/Nebutra-Sailor",
    "sourceDirectory": "packages/design/tokens",
    "sourcePackage": "@nebutra/tokens",
    "sourceSha": "de6f494fa3b75031fc1d4762fa52a7a8dacff1c3",
    "canonicalSource": "monorepo"
  },
  "packageManager": "pnpm@10.32.1"
}
